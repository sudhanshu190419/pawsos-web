rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the request comes from an admin (via Firestore role)
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if the authenticated user is the owner of an organization
    function isOrgOwner(orgId) {
      return orgId != null && orgId != "" &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // USER PROFILES
    // ─────────────────────────────────────────────
    // Owner or admin can read/write.
    // Admins use a Firestore document read to verify their role.
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    // User subcollections (addresses, etc.) — owner only
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // VET REGISTRATIONS  (vets_web)
    // ─────────────────────────────────────────────
    // Any authenticated user can read vet profiles.
    // Owner or admin can write.
    match /vets_web/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // VET CLINICS (legacy clinic collection)
    // ─────────────────────────────────────────────
    // Any authenticated user can read (geo-query from vets_detail page).
    match /vet_clinics/{clinicId} {
      allow read: if request.auth != null;
      // Write not needed from client; populated via admin/cloud functions
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // SELLER / BRAND PROFILES  (brands)
    // ─────────────────────────────────────────────
    // Any authenticated user can read brand profiles.
    // Owner or admin can write.
    match /brands/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // NGO REGISTRATIONS  (ngos_web)
    // ─────────────────────────────────────────────
    // Any authenticated user can read NGO profiles.
    // Owner or admin can write.
    match /ngos_web/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // PRODUCTS
    // ─────────────────────────────────────────────
    // Products have a `brandId` field set to the seller's uid.
    // - Read: public (anyone can browse the shop)
    // - Create: authenticated user whose uid matches the brandId being set
    // - Update: brand owner can update everything; any authenticated user
    //   can decrement stockQty (needed for checkout order placement)
    // - Delete: brand owner only
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.brandId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.brandId == request.auth.uid ||
        request.resource.data.stockQty < resource.data.stockQty
      );
      allow delete: if request.auth != null &&
        resource.data.brandId == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // SHOP PRODUCTS (legacy direct-add from shop page)
    // ─────────────────────────────────────────────
    match /shop_products/{productId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.data.brandId == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // ORDERS
    // ─────────────────────────────────────────────
    // - Read: buyer (userId match), seller (vendorIds contains uid),
    //   or admin.
    // - Create: any authenticated user (checkout).
    // - Update: buyer, seller whose brands are in the order, or admin.
    // - Delete: none (orders are immutable after creation).
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid in resource.data.vendorIds ||
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid in resource.data.vendorIds ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // SOS ALERTS
    // ─────────────────────────────────────────────
    // - Read: any authenticated user.
    // - Create: any authenticated user.
    // - Update: the creator, the responder (acceptedBy), or admin.
    match /sos_alerts/{sosId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Allow updates by: creator, existing acceptedBy, the user currently being
      // set as acceptedBy (for the initial accept action), or admin.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid == resource.data.acceptedBy ||
        request.resource.data.acceptedBy == request.auth.uid ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // PETS
    // ─────────────────────────────────────────────
    match /pets/{petId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // PLAY DATES
    // ─────────────────────────────────────────────
    // Public read so anyone can browse playdates.
    // Write requires authentication.
    match /playdates/{playdateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // VET APPOINTMENTS
    // ─────────────────────────────────────────────
    match /vet_appointments/{appointmentId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.vetId ||
        isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        // User cancelling or submitting review
        (request.auth.uid == resource.data.userId && 
         ((request.resource.data.appointmentStatus == 'cancelled' &&
           (resource.data.appointmentStatus == 'requested' || resource.data.appointmentStatus == 'payment_pending')) ||
          request.resource.data.reviewSubmitted == true)) ||
        // Vet updating status
        (request.auth.uid == resource.data.vetId &&
         (request.resource.data.appointmentStatus == 'accepted' || 
          request.resource.data.appointmentStatus == 'rejected' || 
          request.resource.data.appointmentStatus == 'completed' ||
          request.resource.data.reviewSubmitted == true)) ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // VET REVIEWS
    // ─────────────────────────────────────────────
    match /vet_reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/vet_appointments/$(request.resource.data.appointmentId)).data.appointmentStatus == 'completed' &&
        get(/databases/$(database)/documents/vet_appointments/$(request.resource.data.appointmentId)).data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ─────────────────────────────────────────────
    // INVITATIONS
    // ─────────────────────────────────────────────
    // Any authenticated user can create an invitation.
    // Read: the recipient (userId or userEmail matching auth),
    //   the org owner (orgOwnerId or via orgId lookup), or admin.
    // Update/Delete: admin only (to accept/reject).
    match /invitations/{invitationId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == resource.data.userEmail ||
        request.auth.uid == resource.data.orgOwnerId ||
        isOrgOwner(resource.data.orgId) ||
        isAdmin()
      );
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ─────────────────────────────────────────────
    // ORGANIZATIONS
    // ─────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PENDING ORGANIZATIONS
    // ─────────────────────────────────────────────
    // Only the applicant or admin can read/write.
    match /pending_organizations/{id} {
      allow read, write: if request.auth != null && (
        request.auth.uid == id ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // NOTIFICATIONS
    // ─────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow write: if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PLATFORM SETTINGS (admin only)
    // ─────────────────────────────────────────────
    match /platform_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ─────────────────────────────────────────────
    // DONATION CAMPAIGNS
    // ─────────────────────────────────────────────
    match /donation_campaigns/{campaignId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // ASSIGNED TASKS
    // ─────────────────────────────────────────────
    match /assigned_tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // OTPs (written by Cloud Functions via Admin SDK)
    // ─────────────────────────────────────────────
    // The Admin SDK bypasses security rules, so this is
    // only a safety net. Cloud Functions never go through
    // client-side rules.
    match /otps/{otpId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────
    // CATCH-ALL DENY
    // ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
