rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read — images are displayed on the marketplace, shop, profiles, etc.
    // Authenticated write — users must be signed in to upload files.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
